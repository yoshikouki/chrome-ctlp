{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.5.0",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionOpenPalette__"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "__MSG_commandOpenPaletteDescription__"
    }
  }
}
